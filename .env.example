# Database (PostgreSQL ; sur Railway : référence ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/vtc_booking?schema=public"

# Google Maps API (obligatoire - remplacer par une vraie clé)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Emails via Resend (https://resend.com) — le SMTP est bloqué sur Railway Hobby
RESEND_API_KEY=""
# Expéditeur : nécessite un domaine vérifié chez Resend pour écrire aux clients
EMAIL_FROM="Sama Confort <contact@ton-domaine.fr>"
ADMIN_EMAIL="admin@vtc-booking.com"

# NextAuth (for future admin auth)
NEXTAUTH_SECRET="your_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Seed : mot de passe du compte chauffeur créé par prisma/seed.ts
SEED_DRIVER_PASSWORD=""
