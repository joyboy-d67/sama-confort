// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Fournie automatiquement par le service Postgres de Railway
  url      = env("DATABASE_URL")
}

model Booking {
  id                String              @id @default(cuid())
  firstName         String
  lastName          String
  phoneNumber       String
  email             String?
  userId            String?
  user              User?               @relation(fields: [userId], references: [id])
  departureAddress  String
  destinationAddress String
  departureLat      Float
  departureLng      Float
  destinationLat    Float
  destinationLng    Float
  distance          Float               // in kilometers
  date              DateTime
  timeSlot          String              // e.g., "09:00-10:00"
  price             Float
  additionalServices AdditionalService[]
  isRecurring       Boolean             @default(false)
  recurrenceType    RecurrenceType?
  recurrenceEndDate DateTime?
  status            BookingStatus       @default(PENDING)
  notes             String?
  driverNotified    Boolean             @default(false) // Driver clicked and notified customer
  customerNotified  Boolean             @default(false) // Customer received "driver en route" notification
  tripStarted       Boolean             @default(false) // Driver clicked "Départ du trajet"
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([date, timeSlot])
  @@index([status])
}

model AdditionalService {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model TimeSlot {
  id           String   @id @default(cuid())
  date         DateTime
  slot         String   // e.g., "09:00-10:00"
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, slot])
  @@index([date])
}

model Service {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  price       Float
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id                  String   @id @default(cuid())
  key                 String   @unique
  value               String
  updatedAt           DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  phoneNumber   String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rides         Ride[]
  bookings      Booking[]
}

model Ride {
  id           String   @id @default(cuid())
  date         DateTime
  price        Float
  boltPrice    Float?
  uberPrice    Float?
  distance     Float?
  startAddress String?
  endAddress   String?
  status       String   @default("COMPLETED")
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LiveRide {
  id                    String        @id @default(cuid())
  userId                String
  clientName            String
  clientPhone           String
  departureAddress      String
  departureLat          Float
  departureLng          Float
  destinationAddress    String?
  destinationLat        Float?
  destinationLng        Float?
  status                LiveRideStatus @default(REQUESTED)
  driverId              String?
  driverLat             Float?
  driverLng             Float?
  estimatedArrival      Int?          // ETA en minutes
  price                 Float?
  distance              Float?
  paymentMethod         PaymentMethod @default(APP)
  requestedAt           DateTime      @default(now())
  acceptedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
  @@index([driverId])
}

enum LiveRideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  APP
}

